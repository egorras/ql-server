[Unit]
Description=Quake Live Dedicated Server (via box64)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ql-server-data/qlds
Environment=LD_LIBRARY_PATH=/home/ubuntu/ql-server-data/qlds/linux64
ExecStart=/usr/local/bin/box64 ./qzeroded.x64 +set dedicated 2 +set fs_basepath /home/ubuntu/ql-server-data/qlds +set logfile 0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
